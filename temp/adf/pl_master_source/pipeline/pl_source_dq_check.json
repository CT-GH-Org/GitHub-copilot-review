{
    "name": "pl_source_dq_check",
    "properties": {
        "description": "Data quality check pipeline: runs DQ notebook, evaluates results, and logs DQ failures.",
        "activities": [
            {
                "name": "Run DQ Notebook",
                "type": "DatabricksNotebook",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.01:00:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "notebookPath": {
                        "value": "@pipeline().parameters.dq_notebook_path",
                        "type": "Expression"
                    },
                    "baseParameters": {
                        "source_name": {
                            "value": "@pipeline().parameters.source_name",
                            "type": "Expression"
                        },
                        "entity_name": {
                            "value": "@pipeline().parameters.entity_name",
                            "type": "Expression"
                        }
                    }
                },
                "linkedServiceName": {
                    "referenceName": "databricks_edl",
                    "type": "LinkedServiceReference"
                }
            },
            {
                "name": "If DQ Failed",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "Run DQ Notebook",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "typeProperties": {
                    "expression": {
                        "value": "@equals(activity('Run DQ Notebook').output.runOutput.dq_passed, 'false')",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "Log DQ Failure",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.00:05:00",
                                "retry": 3,
                                "retryIntervalInSeconds": 30
                            },
                            "typeProperties": {
                                "storedProcedureName": "[control].[usp_log_dq_failure]",
                                "storedProcedureParameters": {
                                    "source_name": {
                                        "value": {
                                            "value": "@pipeline().parameters.source_name",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "entity_name": {
                                        "value": {
                                            "value": "@pipeline().parameters.entity_name",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "dq_result": {
                                        "value": {
                                            "value": "@activity('Run DQ Notebook').output.runOutput.dq_summary",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    }
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "sql_metadata_db",
                                "type": "LinkedServiceReference"
                            }
                        }
                    ]
                }
            }
        ],
        "parameters": {
            "source_name": {
                "type": "string"
            },
            "entity_name": {
                "type": "string"
            },
            "dq_notebook_path": {
                "type": "string",
                "defaultValue": ""
            }
        },
        "variables": {},
        "annotations": [
            "dq",
            "quality_check",
            "erp_sales"
        ],
        "folder": {
            "name": "ingestion/erp_sales"
        }
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}