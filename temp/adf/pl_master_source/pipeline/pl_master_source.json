{
    "name": "pl_master_source",
    "properties": {
        "description": "Master orchestrator pipeline for erp_sales source ingestion. Checks readiness, then triggers child execution pipeline or sends notification.",
        "activities": [
            {
                "name": "Lookup Readiness Flag",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": {
                            "value": "SELECT is_ready, last_check_time FROM [control].[source_readiness] WHERE source_name = '@{pipeline().parameters.source_name}'",
                            "type": "Expression"
                        },
                        "queryTimeout": "0.00:05:00"
                    },
                    "dataset": {
                        "referenceName": "ds_azure_sql",
                        "type": "DatasetReference",
                        "parameters": {
                            "schema_name": "control",
                            "table_name": "source_readiness"
                        }
                    },
                    "firstRowOnly": true
                }
            },
            {
                "name": "Send Lookup Failure Notification",
                "type": "WebActivity",
                "dependsOn": [
                    {
                        "activity": "Lookup Readiness Flag",
                        "dependencyConditions": [
                            "Failed"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:05:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "url": {
                        "value": "@pipeline().globalParameters.notification_url",
                        "type": "Expression"
                    },
                    "method": "POST",
                    "headers": {
                        "Content-Type": "application/json"
                    },
                    "body": {
                        "to": {
                            "value": "@pipeline().parameters.notification_email",
                            "type": "Expression"
                        },
                        "subject": {
                            "value": "Lookup Readiness Flag Failed - @{pipeline().parameters.source_name}",
                            "type": "Expression"
                        },
                        "body": {
                            "value": "Lookup Readiness Flag failed for source @{pipeline().parameters.source_name}. Pipeline: @{pipeline().Pipeline}. Run ID: @{pipeline().RunId}. Error: @{activity('Lookup Readiness Flag').error.message}",
                            "type": "Expression"
                        }
                    },
                    "authentication": {
                        "type": "MSI",
                        "resource": "https://management.azure.com/"
                    }
                }
            },
            {
                "name": "Set Load Start Time",
                "type": "SetVariable",
                "dependsOn": [
                    {
                        "activity": "Lookup Readiness Flag",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "typeProperties": {
                    "variableName": "load_start_time",
                    "value": {
                        "value": "@pipeline().TriggerTime",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "If Source Is Ready",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "Set Load Start Time",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "typeProperties": {
                    "expression": {
                        "value": "@equals(activity('Lookup Readiness Flag').output.firstRow.is_ready, 1)",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "Execute Get Execution",
                            "type": "ExecutePipeline",
                            "dependsOn": [],
                            "policy": {
                                "secureInput": false
                            },
                            "typeProperties": {
                                "pipeline": {
                                    "referenceName": "pl_source_get_execution",
                                    "type": "PipelineReference"
                                },
                                "waitOnCompletion": true,
                                "parameters": {
                                    "source_name": {
                                        "value": "@pipeline().parameters.source_name",
                                        "type": "Expression"
                                    },
                                    "adf_master_pipeline_name": {
                                        "value": "@pipeline().Pipeline",
                                        "type": "Expression"
                                    },
                                    "adf_master_pipeline_run_id": {
                                        "value": "@pipeline().RunId",
                                        "type": "Expression"
                                    }
                                }
                            }
                        }
                    ],
                    "ifFalseActivities": [
                        {
                            "name": "Send Not Ready Notification",
                            "type": "WebActivity",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.00:05:00",
                                "retry": 3,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "typeProperties": {
                                "url": {
                                    "value": "@pipeline().globalParameters.notification_url",
                                    "type": "Expression"
                                },
                                "method": "POST",
                                "headers": {
                                    "Content-Type": "application/json"
                                },
                                "body": {
                                    "to": {
                                        "value": "@pipeline().parameters.notification_email",
                                        "type": "Expression"
                                    },
                                    "subject": {
                                        "value": "Source Not Ready - @{pipeline().parameters.source_name}",
                                        "type": "Expression"
                                    },
                                    "body": {
                                        "value": "The @{pipeline().parameters.source_name} source is not ready for ingestion. Last check: @{activity('Lookup Readiness Flag').output.firstRow.last_check_time}.",
                                        "type": "Expression"
                                    }
                                },
                                "authentication": {
                                    "type": "MSI",
                                    "resource": "https://management.azure.com/"
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "Send Summary Email",
                "type": "WebActivity",
                "dependsOn": [
                    {
                        "activity": "If Source Is Ready",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:05:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "url": {
                        "value": "@pipeline().globalParameters.notification_url",
                        "type": "Expression"
                    },
                    "method": "POST",
                    "headers": {
                        "Content-Type": "application/json"
                    },
                    "body": {
                        "to": {
                            "value": "@pipeline().parameters.notification_email",
                            "type": "Expression"
                        },
                        "subject": {
                            "value": "Master Pipeline Summary - @{pipeline().parameters.source_name}",
                            "type": "Expression"
                        },
                        "body": {
                            "value": "Master pipeline @{pipeline().Pipeline} completed. Run ID: @{pipeline().RunId}. Start time: @{variables('load_start_time')}.",
                            "type": "Expression"
                        }
                    },
                    "authentication": {
                        "type": "MSI",
                        "resource": "https://management.azure.com/"
                    }
                }
            },
            {
                "name": "Log Master Audit",
                "type": "SqlServerStoredProcedure",
                "dependsOn": [
                    {
                        "activity": "If Source Is Ready",
                        "dependencyConditions": [
                            "Completed"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:05:00",
                    "retry": 3,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "typeProperties": {
                    "storedProcedureName": "[control].[usp_log_pipeline_audit]",
                    "storedProcedureParameters": {
                        "pipeline_name": {
                            "value": {
                                "value": "@pipeline().Pipeline",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "pipeline_run_id": {
                            "value": {
                                "value": "@pipeline().RunId",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "source_name": {
                            "value": {
                                "value": "@pipeline().parameters.source_name",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "status": {
                            "value": "Completed",
                            "type": "String"
                        },
                        "load_start_time": {
                            "value": {
                                "value": "@variables('load_start_time')",
                                "type": "Expression"
                            },
                            "type": "String"
                        },
                        "duration_seconds": {
                            "value": {
                                "value": "@div(sub(ticks(utcNow()), ticks(variables('load_start_time'))), 10000000)",
                                "type": "Expression"
                            },
                            "type": "Int32"
                        }
                    }
                },
                "linkedServiceName": {
                    "referenceName": "sql_metadata_db",
                    "type": "LinkedServiceReference"
                }
            }
        ],
        "concurrency": 1,
        "parameters": {
            "source_name": {
                "type": "string",
                "defaultValue": "erp_sales"
            },
            "adf_master_pipeline_run_id": {
                "type": "string"
            },
            "notification_email": {
                "type": "string",
                "defaultValue": "data-ops@contoso.com"
            }
        },
        "variables": {
            "load_start_time": {
                "type": "String",
                "defaultValue": ""
            }
        },
        "annotations": [
            "master",
            "erp_sales",
            "orchestrator"
        ],
        "folder": {
            "name": "ingestion/erp_sales"
        }
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}